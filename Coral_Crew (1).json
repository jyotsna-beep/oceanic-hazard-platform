    },
    {
      "parameters": {
        "jsCode": "return items.map(item => {\n    let pred = {};\n    try {\n        // parse stdout string into JSON\n        pred = JSON.parse($input.first().json.stdout);\n    } catch (e) {\n        pred = { prediction: [0] };\n    }\n\n    let value = Array.isArray(pred.prediction) && pred.prediction.length > 0 ? pred.prediction[0] : 0;\n    let hazard_status = value > 0.5 ? 'Yes' : 'No';\n\n    return { json: { hazard_status } };\n});\n"
      },
