    {
      "parameters": {
        "jsCode": "// Function Node to parse all merged outputs into proper JSON array\nreturn [\n  {\n    json: {\n      hazards: $json.merged.map(item => {\n        // Remove ```json\\n and ``` from the string\n        let cleanOutput = item.output.replace(/```json\\s*/, '').replace(/```/g, '');\n        return JSON.parse(cleanOutput);\n      })\n    }\n  }\n];\n"
      },
